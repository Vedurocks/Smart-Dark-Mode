{
  "manifest_version": 3,
  "name": "Smart Dark Mode Controller",
  "version": "3.0.0",
  "description": "AI-powered dark mode that learns your preferences per website",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/storage.js", "content/content.js"],
      "css": ["content/dark-mode.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}